#!/bin/sh
# Local mirror of the CI gate, scoped to what the commit touches.
# Activate with:  git config core.hooksPath .githooks
# Skip once with: git commit --no-verify
set -e

staged=$(git diff --cached --name-only --diff-filter=ACMR)

case "$staged" in
*.rs* | *Cargo.toml* | *Cargo.lock*) ;;
*)
    # No Rust staged (docs, web, workflows): nothing to validate here.
    exit 0
    ;;
esac

echo "pre-commit: cargo fmt --check"
cargo fmt --all --check || {
    echo "pre-commit: formatting differs; run 'cargo fmt --all' and re-stage" >&2
    exit 1
}

echo "pre-commit: cargo clippy (native)"
cargo clippy --workspace --all-targets --quiet -- -D warnings

# The sans-IO gate: only worth the extra compile when core changed.
if echo "$staged" | grep -q "^crates/printa-ble-core/"; then
    echo "pre-commit: cargo clippy (wasm32, core changed)"
    cargo clippy -p printa-ble-web --target wasm32-unknown-unknown --quiet -- -D warnings
fi

echo "pre-commit: ok (tests run in CI; 'cargo test --workspace' to run them now)"
